# ── Producción · variables del docker-compose.prod.yml ──────────────────────
# Copiá a  .env  en la raíz del repo (en el VPS) y completá. NO se commitea.
# Estas las usa el COMPOSE (substitución ${...} en labels, build args y env).

# Dominio raíz del proyecto (sin https://). La app queda en https://<DOMAIN>.
# Apuntá el DNS A de @ (y opcionalmente www) al IP del VPS.
DOMAIN=app.apops.org.ar

# ── Supabase (cloud — el cliente tiene su propio proyecto) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
# CRÍTICO: secreto. Bypasea RLS. Solo server-side.
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BHnFm...
VAPID_PRIVATE_KEY=xKjLP...
VAPID_SUBJECT=mailto:apops@apops.org.ar

# ── Email transaccional (Resend) ────────────────────────────────────────────
# Dominio debe estar verificado en Resend antes de mandar mail real.
RESEND_API_KEY=re_xxx
EMAIL_FROM=APOPS Siempre <noreply@apops.org.ar>
