# ============================================================
# APOPS PWA — Variables de entorno (PLANTILLA)
#
# Cómo usar:
#   1. Copiá este archivo a .env.local:    cp .env.example .env.local
#   2. Pedile los valores a quien tenga acceso al panel de Supabase/Vercel
#   3. NUNCA commitees .env.local (está en .gitignore)
#
# Las variables NEXT_PUBLIC_* viajan al cliente (visibles en el bundle).
# El resto son server-side only y deben permanecer secretas.
# ============================================================

# ---------- Supabase ----------
# Panel: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Solo server-side. Bypass de RLS — usar SOLO en Edge Functions y nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------- Web Push (VAPID) ----------
# Generar con: npx web-push generate-vapid-keys
# Guardar la pública en NEXT_PUBLIC_VAPID_PUBLIC_KEY (visible al cliente para subscribe)
# Guardar la privada en VAPID_PRIVATE_KEY (server-only, firma el envío del push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public>
VAPID_PRIVATE_KEY=<vapid-private>
VAPID_SUBJECT=mailto:sistemas@apops.org.ar

# ---------- Claude API ----------
# Para el módulo del delegado: respuestas sugeridas con IA
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---------- App ----------
# URL base del frontend. En desarrollo: http://localhost:3000
# En producción: https://app.apops.org.ar
NEXT_PUBLIC_APP_URL=http://localhost:3000
